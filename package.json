{
  "name": "railmark-ai",
  "version": "2.0.0",
  "description": "RailMark AI — AI-Assisted Laser QR Marking & Digital Traceability for Railway Track Fittings",
  "main": "railmark-backend/dist/server.js",
  "type": "module",
  "scripts": {
    "postinstall": "npm --prefix railmark-backend install --omit=dev",
    "build": "node build.js",
    "build:all": "node build.js",
    "start": "node railmark-backend/dist/server.js",
    "dev": "npm --prefix railmark-backend run dev",
    "prisma:generate": "npm --prefix railmark-backend run prisma:generate",
    "prisma:push": "npm --prefix railmark-backend run prisma:push",
    "prisma:migrate": "npm --prefix railmark-backend run prisma:migrate",
    "prisma:seed": "npm --prefix railmark-backend run prisma:seed"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "railway",
    "qr-code",
    "track-fittings",
    "railmark",
    "postgresql",
    "prisma"
  ],
  "author": "RailMark AI Team",
  "license": "MIT"
}
