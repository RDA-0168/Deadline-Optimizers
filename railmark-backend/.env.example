# RailMark AI - Backend Server Configuration
# ==========================================

NODE_ENV=development
PORT=5000

# Security & Authentication
JWT_SECRET=railmark_secure_sih_prototype_jwt_secret_key_2026!
JWT_EXPIRES_IN=7d

# CORS Origin (comma-separated or * for all)
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# Database Configuration
# DB_TYPE: 'memory' | 'postgres'
DB_TYPE=memory

# PostgreSQL Connection (Only required if DB_TYPE=postgres)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/railmark_db
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=postgres
# PG_PASSWORD=password
# PG_DATABASE=railmark_db
